# vrouter does not load .env automatically. Export these in your shell or service.
VROUTER_ADDR=127.0.0.1:8080
# Browser-facing origin, e.g. https://vrouter.example.com. Leave empty for
# local development. No subpath; reverse proxies must preserve Host.
VROUTER_PUBLIC_URL=
# Account store and private client-key location. Defaults to
# $XDG_STATE_HOME/vrouter, or ~/.local/state/vrouter when unset.
VROUTER_DATA_DIR=
# Optional legacy client API key for the default gateway. Additional keys
# can be created in the UI, including when this is empty.
VROUTER_API_KEY=
# Optional administrator token. Use this or external authentication for remote hosting.
VROUTER_ADMIN_TOKEN=


# Set only when an authentication proxy such as TinyAuth protects every
# dashboard and /api route, and clients cannot reach the backend directly.
# Keep /v1 routes outside browser authentication; they require vrouter API keys.
VROUTER_EXTERNAL_AUTH=0

# Plans that never get an automatic 5-hour window trigger, comma-separated as
# plan or provider:plan; a trailing * matches any ending. Defaults to
# codex:pro*, which covers every Codex Pro tier; set to none to
# trigger on every plan.
VROUTER_WINDOW_SKIP_PLANS=
