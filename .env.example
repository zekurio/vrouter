# vrouter does not load .env automatically. Export these in your shell or service.
VROUTER_ADDR=127.0.0.1:8080
# Required. Browser-facing origin, e.g. https://vrouter.example.com, or
# http://localhost:8080 locally. No subpath; reverse proxies must preserve Host.
# Register this origin followed by /api/auth/callback with the OIDC client.
VROUTER_PUBLIC_URL=
# Data directory. Defaults to $XDG_STATE_HOME/vrouter, or
# ~/.local/state/vrouter when unset.
VROUTER_DATA_DIR=

# Required. OpenID Connect sign-in, e.g. with Pocket ID. The issuer must use
# https unless the provider runs on this machine.
VROUTER_OIDC_ISSUER=
VROUTER_OIDC_CLIENT_ID=
# The client secret, or a file holding it. Set at most one; leave both empty
# for a public client.
VROUTER_OIDC_CLIENT_SECRET=
VROUTER_OIDC_CLIENT_SECRET_FILE=
# Roles come from the provider's vrouter_role claim, admin or member. People
# without one cannot sign in.

# Plans that never get an automatic 5-hour window trigger, comma-separated as
# plan or provider:plan; a trailing * matches any ending. Defaults to
# codex:pro*, which covers every Codex Pro tier; set to none to
# trigger on every plan.
VROUTER_WINDOW_SKIP_PLANS=
