# vrouter does not load .env automatically. Export these in your shell or service.
VROUTER_ADDR=127.0.0.1:8080
# Account store and private client-key location. Defaults to
# $XDG_STATE_HOME/vrouter, or ~/.local/state/vrouter when unset.
VROUTER_DATA_DIR=
# Optional legacy client API key for the default gateway. Additional keys
# can be created in the UI, including when this is empty.
VROUTER_API_KEY=
# Administrator token. A non-loopback listener requires this or OIDC providers.
VROUTER_ADMIN_TOKEN=
# Set to 1 for sample data; leave unset to serve stored accounts.
VROUTER_DEMO=0

# Optional multi-user login. Register /auth/callback/company at your issuer.
# HTTPS is required except for loopback development URLs.
VROUTER_PUBLIC_URL=https://router.example.com
# JSON provider definitions; leave empty to retain local/admin-token login.
# Secrets are read from the named env var, never embedded in provider JSON.
# VROUTER_OAUTH_PROVIDERS='[{"id":"company","name":"Company sign-in","issuer":"https://identity.example.com/realms/company","clientId":"vrouter","clientSecretEnv":"ROUTER_OIDC_SECRET","scopes":["openid","profile","email","groups"],"roleMappings":[{"claim":"groups","value":"router-users","role":"user"},{"claim":"groups","value":"router-admins","role":"admin"}]}]'
VROUTER_OAUTH_PROVIDERS=
# ROUTER_OIDC_SECRET=
