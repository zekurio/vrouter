  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "8.3.3"
  },
  "packageManager": "pnpm@12.9.0"
}
