{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y",
    "promise"
  ],
  "options": {
    // Type-aware rules run through oxlint-tsgolint.
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "env": {
    "browser": true,
    "es2023": true
  },
  "settings": {
    "react": { "version": "19" }
  },
  "rules": {
    "react-hooks/exhaustive-deps": "error",
    // The new JSX transform needs no React import.
    "react/react-in-jsx-scope": "off",
    // React Compiler rules. The UI doesn't use the compiler.
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    // Duplicates react-hooks/exhaustive-deps.
    "react/exhaustive-effect-dependencies": "off",
    // DOM and React types are mutable, so nearly every parameter would need a
    // hand-written readonly wrapper.
    "typescript/prefer-readonly-parameter-types": "off",
    // Size and complexity limits, roughly matching .golangci.yml.
    "eslint/complexity": ["error", { "max": 15 }],
    "eslint/max-depth": ["error", { "max": 4 }],
    "eslint/max-lines": [
      "error",
      { "max": 400, "skipBlankLines": true, "skipComments": true }
    ],
    "eslint/max-lines-per-function": [
      "error",
      { "max": 150, "skipBlankLines": true, "skipComments": true }
    ],
    "eslint/max-nested-callbacks": ["error", { "max": 4 }],
    "eslint/max-params": ["error", { "max": 4 }],
    "eslint/max-statements": ["error", { "max": 30 }],
    // role="status" on a div is valid ARIA, and <output> is form-associated.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Conflicts with typescript/consistent-return: an effect that only
    // sometimes has a cleanup has to say `return undefined`.
    "unicorn/no-useless-undefined": "off",
    "typescript/no-confusing-void-expression": [
      "error",
      { "ignoreArrowShorthand": true }
    ],
    // The listbox pattern puts listbox on <ul> and option on <li>.
    "jsx-a11y/no-noninteractive-element-to-interactive-role": [
      "error",
      {
        "ul": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree"],
        "li": ["menuitem", "option", "row", "tab", "treeitem"]
      }
    ],
    // Scrollable code blocks take focus so the keyboard can scroll them.
    "jsx-a11y/no-noninteractive-tabindex": ["error", { "tags": ["pre"] }],
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@fontsource-variable/*"] }
    ]
  },
  "ignorePatterns": ["dist"]
}
